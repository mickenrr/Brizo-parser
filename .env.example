# ────────────────────────────────────────────────────────────────────────────
# Brizo Lead Finder — пример переменных окружения
# Скопируй этот файл в .env и заполни реальными значениями
# НИКОГДА не коммить .env в git!
# ────────────────────────────────────────────────────────────────────────────

# Пароль для входа в сам веб-интерфейс Lead Finder
# (защита от посторонних; любое слово на ваш выбор)
APP_PASSWORD=your_secret_password_here

# Адрес Brizo CRM (обычно не меняется)
BRIZO_URL=https://sad1.brizo.ru

# Порт, на котором запустится сервер (Railway/Render подставят сами)
# PORT=8082

# Dadata API — источник компаний для lead_generator.py
# Регистрация бесплатная на dadata.ru, 10 000 запросов/день
DADATA_API_KEY=your_dadata_api_key_here

# OpenRouter API — основной провайдер для анализа Сколково (есть бесплатные модели)
# Регистрация на openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Groq API — резервный провайдер (бесплатно, модель llama-3.1-8b-instant)
# Регистрация на console.groq.com
GROQ_API_KEY=

# Google Gemini API — резервный провайдер (модель gemini-1.5-flash)
# Регистрация на aistudio.google.com
GEMINI_API_KEY=
